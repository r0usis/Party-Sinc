<?xml version="1.0" encoding="utf-8"?>
<!-- App nativo do Festa Sync (Kotlin + Compose). Fala com o mesmo servidor do site
     (festa-sync.r0usis.partykit.dev), então quem está no app e quem está no site ficam na
     mesma sala. Ver app-nativo/LEIA-ME.md. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- chat de voz: só é pedido quando a pessoa aperta o botão do microfone -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- segundo plano (PlaybackService): música, sincronização e voz com a tela apagada / em
         outro app, com os controles na notificação e na tela de bloqueio -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/FestaTheme"
        android:allowBackup="true"
        android:supportsRtl="false">
        <!-- configChanges: girar a tela não recria a tela (senão o player do YouTube
             recarregava e a música cortava a cada vez que alguém virava o celular) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|microphone" />
    </application>
</manifest>
